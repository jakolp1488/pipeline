# Local configuration for tiktok_test.py — copy to .env (git-ignored) and fill in.
# NEVER commit this file with real values. NEVER put TIKTOK_CLIENT_SECRET here.

# Your deployed Worker URL (from `wrangler deploy` output)
TIKTOK_WORKER_URL=https://pipeline-tiktok-oauth.YOUR-SUBDOMAIN.workers.dev

# The same random string you set as `wrangler secret put WORKER_API_TOKEN`
WORKER_API_TOKEN=

# Optional: set a token directly instead of using the Worker
TIKTOK_ACCESS_TOKEN=
